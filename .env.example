
# ==================== 数据库 ====================
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=change-your-password
POSTGRES_DB=clouddrive

# ==================== Redis ====================
# Redis 访问密码（生产环境务必修改）
REDIS_PASSWORD=change-your-redis-password

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-your-password

# ==================== JWT ====================
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 前端 ====================

# 浏览器访问后端的地址（部署时改为实际域名）
NEXT_PUBLIC_API_URL=http://localhost:8000

# 前端容器内部访问后端的地址（Docker 内部网络）
API_URL=http://backend:8000

# ==================== 管理员与配额 ====================

# 用此邮箱注册的用户自动成为管理员（留空则不启用引导）
ADMIN_EMAIL=admin@example.com

# 最大注册用户数（0 = 不限制）
MAX_USERS=0

# 新用户默认云盘配额（字节），1073741824 = 1GB
DEFAULT_STORAGE_QUOTA=1073741824

# ==================== 日志 ====================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（容器内路径，对应 ./backend/logs）
LOG_DIR=logs
# 日志保留天数
LOG_RETENTION_DAYS=30

# ==================== 备份 ====================
# 备份保留天数（超过自动清理）
BACKUP_RETENTION_DAYS=7
# Cron 表达式（分 时 日 月 周），默认每天凌晨 3:00
BACKUP_CRON=0 3 * * *
# 容器启动时是否立即执行一次备份（true/false）
BACKUP_RUN_ON_START=false
# 备份加密密钥（留空则不加密；设置后用 GPG AES256 对数据库备份加密）
BACKUP_ENCRYPT_KEY=
# 管理后台触发备份的方式（已废弃 docker exec，改用共享卷触发文件，无需 Docker socket）
# 留空则使用默认的共享卷触发机制
BACKUP_TRIGGER_CMD=

# ==================== 告警 ====================
# 是否启用日志告警（ERROR 时发送通知）
ALERT_ENABLED=false
# 触发告警的最低日志级别（ERROR / CRITICAL）
ALERT_MIN_LEVEL=ERROR
# 同一错误冷却时间（秒），防止刷屏
ALERT_COOLDOWN_SECONDS=300

# ---- Webhook 通知（钉钉/飞书/企业微信/通用）----
ALERT_WEBHOOK_URL=
# Webhook 类型：generic / dingtalk / feishu / wechat
ALERT_WEBHOOK_TYPE=generic

# ---- 邮件通知（SMTP）----
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_USE_TLS=true

# ==================== 找回密码邮件 ====================
# 留空则复用上方告警邮件 SMTP 配置
RESET_PASSWORD_SMTP_HOST=
RESET_PASSWORD_SMTP_PORT=465
RESET_PASSWORD_SMTP_USER=
RESET_PASSWORD_SMTP_PASSWORD=
RESET_PASSWORD_FROM_EMAIL=
RESET_PASSWORD_FROM_NAME=筋斗云盘
# 验证码有效期（秒），默认 600=10分钟
RESET_PASSWORD_CODE_EXPIRE_SECONDS=600
# 验证码位数，默认 6
RESET_PASSWORD_CODE_LENGTH=6

# ==================== 环境与部署 ====================
# 是否为生产环境（production 时后端自动切换为 Gunicorn 多 worker 模式）
# ENVIRONMENT=production

# Gunicorn worker 进程数（生产环境生效，建议 2~4，CPU 密集型可增加）
BACKEND_WORKERS=4

# ==================== Celery 异步任务队列 ====================
# Broker URL（留空则自动从 REDIS_URL 派生，使用 Redis DB 1）
# CELERY_BROKER_URL=redis://:redispass123@redis:6379/1
# Result Backend URL（留空则自动从 REDIS_URL 派生，使用 Redis DB 2）
# CELERY_RESULT_BACKEND_URL=redis://:redispass123@redis:6379/2
# Eager 模式：任务在调用进程内同步执行（仅用于开发/测试，生产务必设为 false）
CELERY_TASK_ALWAYS_EAGER=false
# Celery Worker 并发数
CELERY_CONCURRENCY=4

# 数据库连接池配置
# 开发模式（单 worker）：pool_size=5, max_overflow=5，最多 10 连接
# 生产模式（4 worker）：pool_size=10, max_overflow=5，每 worker 最多 15，总计最多 60 连接
# 确保 WORKERS × (POOL_SIZE + MAX_OVERFLOW) < DB_MAX_CONNECTIONS（默认 80）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# PostgreSQL 最大连接数（需 ≥ WORKERS × (POOL_SIZE + MAX_OVERFLOW) + 预留）
DB_MAX_CONNECTIONS=80

# 是否强制 HTTPS 重定向（生产环境启用 SSL 证书后设为 true）
HTTPS_REDIRECT=false

# 是否启用安全响应头（CSP/HSTS/X-Frame-Options 等）
SECURITY_HEADERS_ENABLED=true

# ==================== 限流 ====================
# 是否启用全局限流（基于 IP + 路径的滑动窗口）
RATE_LIMIT_ENABLED=true
# 每分钟每个 IP 对同一路径的最大请求数
RATE_LIMIT_PER_MINUTE=60

# ==================== CORS ====================
# 允许的前端源（逗号分隔，生产环境改为实际域名）
CORS_ORIGINS=http://localhost:3000