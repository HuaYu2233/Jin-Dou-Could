
# ==================== 数据库 ====================
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=change-your-password
POSTGRES_DB=clouddrive

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-your-password

# ==================== JWT ====================
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 前端 ====================

# 浏览器访问后端的地址（部署时改为实际域名）
NEXT_PUBLIC_API_URL=http://localhost:8000

# 前端容器内部访问后端的地址（Docker 内部网络）
API_URL=http://backend:8000

# ==================== 管理员与配额 ====================

# 用此邮箱注册的用户自动成为管理员（留空则不启用引导）
ADMIN_EMAIL=admin@example.com

# 最大注册用户数（0 = 不限制）
MAX_USERS=0

# 新用户默认云盘配额（字节），1073741824 = 1GB
DEFAULT_STORAGE_QUOTA=1073741824

# ==================== 日志 ====================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（容器内路径，对应 ./backend/logs）
LOG_DIR=logs
# 日志保留天数
LOG_RETENTION_DAYS=30

# ==================== 备份 ====================
# 备份保留天数（超过自动清理）
BACKUP_RETENTION_DAYS=7
# Cron 表达式（分 时 日 月 周），默认每天凌晨 3:00
BACKUP_CRON=0 3 * * *
# 容器启动时是否立即执行一次备份（true/false）
BACKUP_RUN_ON_START=false
# 备份加密密钥（留空则不加密；设置后用 GPG AES256 对数据库备份加密）
BACKUP_ENCRYPT_KEY=
# 备份加密密钥（留空则不加密；设置后用 GPG AES256 对数据库备份加密）
BACKUP_ENCRYPT_KEY=