FROM alpine:3.18

RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories

RUN apk add --no-cache \
    postgresql-client \
    postgresql-dev \
    gzip \
    curl \
    busybox-suid \
    gnupg

RUN (curl -fsSL --connect-timeout 15 --retry 2 \
    https://dl.min.io/client/mc/release/linux-amd64/mc \
    -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc) \
    || (curl -fsSL --connect-timeout 15 --retry 2 \
    https://ghproxy.com/https://github.com/minio/mc/releases/latest/download/mc \
    -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc) \
    || (curl -fsSL --connect-timeout 15 --retry 2 \
    https://mirror.ghproxy.com/https://github.com/minio/mc/releases/latest/download/mc \
    -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc)

RUN addgroup -S backupgrp && adduser -S backupusr -G backupgrp

COPY --chmod=755 backup.sh /scripts/backup.sh
COPY --chmod=755 restore.sh /scripts/restore.sh
COPY --chmod=755 backup-entrypoint.sh /scripts/backup-entrypoint.sh
COPY --chmod=755 backup-trigger-watcher.sh /scripts/backup-trigger-watcher.sh

RUN mkdir -p /backups /var/log \
    && chown -R backupusr:backupgrp /backups /var/log /scripts

USER backupusr

WORKDIR /scripts

ENTRYPOINT ["/scripts/backup-entrypoint.sh"]